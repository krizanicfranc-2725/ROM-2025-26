 RowBox[{"porazdelitevOcen", " ", "=", " ", 
  RowBox[{"Drop", "[", 
   RowBox[{
    RowBox[{"BinCounts", "[", 
     RowBox[{"ocene", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "11", ",", "1"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "6"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9859303117508984`*^9, 3.9859303557015076`*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"73eaa89d-5ab8-d047-93a8-1f4e01a75fba"],

