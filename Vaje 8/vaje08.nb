 RowBox[{"podatki", " ", "=", " ", 
  RowBox[{"First", "[", 
   RowBox[{"Import", "[", 
    RowBox[{"\"\<rezultati.xlsx\>\"", ",", " ", "\"\<Dataset\>\"", ",", " ", 
